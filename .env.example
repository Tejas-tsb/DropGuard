# Leave blank for local development, where Vite proxies /api to the backend.
# Set this in Vercel to the deployed Render API origin, without a trailing slash.
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Backend settings (read by FastAPI)
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
