{
  "name": "dropguard",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend --prefix-colors blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:frontend": "npm --workspace frontend run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm --workspace frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
